NODE_ENV=development
HOST=127.0.0.1
PORT=4000
JWT_SECRET=change-this-secret-with-at-least-32-characters
CORS_ORIGIN=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8081,http://localhost:8081
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=40
LOG_LEVEL=info
# La instalacion local documentada usa el puerto aislado 55432.
DATABASE_URL=postgresql://flash_runtime:replace-with-a-runtime-password@127.0.0.1:55432/flash
MIGRATION_DATABASE_URL=postgresql://flash_app:replace-with-a-migration-password@127.0.0.1:55432/flash
RLS_AUDIT_DATABASE_URL=postgresql://flash_rls_audit:replace-with-an-audit-password@127.0.0.1:55432/flash
DATABASE_SSL=false
ALLOW_SANDBOX_TOPUPS=true
PAYMENT_WEBHOOK_SECRET=replace-with-a-strong-provider-webhook-secret
METRICS_TOKEN=replace-with-a-random-observability-scrape-token
NOTIFICATION_PROVIDER=sandbox
PUSH_TOKEN_ENCRYPTION_KEY=replace-with-a-random-secret-of-at-least-32-characters
DELIVERY_PIN_SECRET=replace-with-an-independent-random-secret-of-at-least-32-characters
MFA_ENCRYPTION_KEY=replace-with-an-independent-random-secret-of-at-least-32-characters
KYC_DOCUMENT_ENCRYPTION_KEY=replace-with-an-independent-random-secret-of-at-least-32-characters
DELIVERY_PROOF_ENCRYPTION_KEY=replace-with-an-independent-random-secret-of-at-least-32-characters
RECOVERY_TOKEN_ENCRYPTION_KEY=replace-with-an-independent-random-secret-of-at-least-32-characters
EMAIL_PROVIDER=sandbox
APP_PUBLIC_URL=http://127.0.0.1:8081
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Flash <noreply@flash.local>
REQUIRE_ADMIN_MFA=false
REALTIME_RETENTION_DAYS=7
REALTIME_MAX_ROWS=100000
GEOCODING_URL=https://nominatim.openstreetmap.org
ROUTING_URL=https://router.project-osrm.org
GEOCODING_CACHE_TTL_SECONDS=604800
ROUTING_CACHE_TTL_SECONDS=900
OTEL_ENABLED=false
OTEL_SERVICE_NAME=flash-api
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces
MAP_PROVIDER_TIMEOUT_MS=5000
MAP_PROVIDER_FAILURE_THRESHOLD=5
MAP_PROVIDER_RESET_MS=30000
MAP_PROVIDER_DAILY_BUDGET=10000
MAP_STALE_CACHE_SECONDS=86400
FEATURE_FLAG_SALT=replace-with-an-independent-random-secret-of-at-least-32-characters
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_REQUIRED=false
SHUTDOWN_GRACE_MS=10000
PHONE_VERIFY_PROVIDER=sandbox
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
PAYMENT_MARKETPLACE_PROVIDER=disabled
PAYMENT_OAUTH_ENCRYPTION_KEY=replace-with-an-independent-random-secret-of-at-least-32-characters
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=
MERCADOPAGO_REDIRECT_URI=http://127.0.0.1:4000/api/payment-provider/mercadopago/callback
PAYMENT_OAUTH_RETURN_URL=http://127.0.0.1:5173
MERCADOPAGO_WEBHOOK_SECRET=
# Docker Compose local: reemplazar antes de compartir el entorno fuera de la maquina.
POSTGRES_ADMIN_PASSWORD=flash_local_admin_password
MIGRATION_DATABASE_PASSWORD=flash_local_migration_password
RUNTIME_DATABASE_PASSWORD=flash_local_runtime_password
AUDIT_DATABASE_PASSWORD=flash_local_audit_password
