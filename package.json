    "test:mfa": "node --env-file-if-exists=.env.local scripts/mfa-smoke.mjs",
    "test:performance": "node --env-file-if-exists=.env.local scripts/performance-smoke.mjs",
    "test:maps": "node --env-file-if-exists=.env.local scripts/maps-smoke.mjs",
