    "test:email-verification": "node --env-file-if-exists=.env.local scripts/email-verification-smoke.mjs",
    "test:phone-verification": "node --env-file-if-exists=.env.local scripts/phone-verification-smoke.mjs",
    "test:payment-oauth": "node scripts/payment-oauth-security-smoke.mjs",
    "test:mercadopago-webhook": "node scripts/mercadopago-webhook-smoke.mjs",
    "test:mercadopago-payment": "node scripts/mercadopago-payment-smoke.mjs",
    "test:marketplace-ledger": "node scripts/marketplace-ledger-smoke.mjs",
    "test:referrals": "node --env-file-if-exists=.env.local scripts/referrals-smoke.mjs",
    "test:audience-bootstrap": "node --env-file-if-exists=.env.local scripts/audience-bootstrap-smoke.mjs",
    "test:activity-pagination": "node --env-file-if-exists=.env.local scripts/activity-pagination-smoke.mjs",
    "test:secrets": "node scripts/secret-scan.mjs",
    "test:dependency-gate": "npm audit --omit=dev --audit-level=high && npm --prefix apps/mobile audit --omit=dev --audit-level=high",
    "test:mobile-build-variants": "node scripts/mobile-build-variants-smoke.mjs",
    "test:catalog-pagination": "node --env-file-if-exists=.env.local scripts/catalog-pagination-smoke.mjs",
    "test:operations-resources": "node --env-file-if-exists=.env.local scripts/operations-resources-smoke.mjs",
    "test:telemetry": "node scripts/telemetry-smoke.mjs",
    "test:city-isolation": "node --env-file-if-exists=.env.local scripts/city-isolation-smoke.mjs",
    "test:observability-rules": "node scripts/observability-rules-smoke.mjs",
    "test:provider-resilience": "node scripts/provider-resilience-smoke.mjs",
