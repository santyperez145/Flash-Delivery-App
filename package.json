    "test:remote-sessions": "node --env-file-if-exists=.env.local scripts/remote-sessions-smoke.mjs",
    "test:redis-rate-limit": "node scripts/redis-rate-limit-smoke.mjs",
    "test:container-security": "node scripts/container-security-smoke.mjs",
    "test:web-bundle-budget": "node scripts/web-bundle-budget.mjs",
    "test:web-delivery": "node scripts/web-delivery-smoke.mjs",
    "test:openapi-contract": "node scripts/openapi-contract-smoke.mjs",
    "test:graceful-shutdown": "node scripts/graceful-shutdown-smoke.mjs"
