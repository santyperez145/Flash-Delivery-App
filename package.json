    "test:driver-vehicles": "node --env-file-if-exists=.env.local scripts/driver-vehicles-smoke.mjs",
    "test:mobile-native-runtime": "node scripts/mobile-native-runtime-smoke.mjs",
    "test:ride-safety": "node --env-file-if-exists=.env.local scripts/ride-safety-smoke.mjs",
    "test:service-chat": "node --env-file-if-exists=.env.local scripts/service-chat-smoke.mjs",
    "test:shipment-claims": "node --env-file-if-exists=.env.local scripts/shipment-claims-smoke.mjs",
    "test:payment-reconciliation": "node --env-file-if-exists=.env.local scripts/payment-reconciliation-smoke.mjs",
