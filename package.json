{
  "name": "flash-delivery-marketplace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n API,WEB -c orange,cyan \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "node --env-file-if-exists=.env.local server/start.js",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc && vite build",
    "check": "npm run build && npm run test:security",
    "db:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-local-db.ps1",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/db-migrate.mjs",
    "db:seed:auth": "node --env-file-if-exists=.env.local scripts/db-seed-auth.mjs",
    "db:seed:addresses": "node --env-file-if-exists=.env.local scripts/db-seed-addresses.mjs",
    "db:seed:commerce": "node --env-file-if-exists=.env.local scripts/db-seed-commerce.mjs",
    "db:seed:orders": "node --env-file-if-exists=.env.local scripts/db-seed-orders.mjs",
    "db:seed:mobility": "node --env-file-if-exists=.env.local scripts/db-seed-mobility.mjs",
    "db:seed:wallet": "node --env-file-if-exists=.env.local scripts/db-seed-wallet.mjs",
    "db:check": "node --env-file-if-exists=.env.local scripts/db-check.mjs",
    "db:backup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/backup-local-db.ps1",
    "db:backup:verify": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-local-backup.ps1",
    "db:restore:drill": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/restore-drill.ps1",
    "worker:notifications": "node --env-file-if-exists=.env.local scripts/notification-worker.mjs",
    "devices:encrypt": "node --env-file-if-exists=.env.local scripts/encrypt-device-tokens.mjs",
    "worker:dispatch": "node --env-file-if-exists=.env.local scripts/dispatch-worker.mjs",
    "worker:pricing": "node --env-file-if-exists=.env.local scripts/pricing-worker.mjs",
    "worker:mercadopago": "node --env-file-if-exists=.env.local scripts/mercadopago-webhook-worker.mjs",
    "worker:payment-oauth": "node --env-file-if-exists=.env.local scripts/payment-oauth-refresh-worker.mjs",
    "worker:support": "node --env-file-if-exists=.env.local scripts/support-worker.mjs",
    "realtime:prune": "node --env-file-if-exists=.env.local scripts/realtime-prune.mjs",
    "mobile:start": "npm --prefix apps/mobile run start",
    "mobile:typecheck": "npm --prefix apps/mobile run typecheck",
